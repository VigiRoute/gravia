# === Dev (local) ===

# MinIO (stockage objet S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gravia

# PostgreSQL (couche Gold)
DATABASE_URL=postgresql://gravia:gravia@localhost:5432/gravia

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Redis (cache)
REDIS_URL=redis://localhost:6379

# Redpanda / Kafka (temps réel)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# LocalStack (émulation AWS pour Terraform)
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-1

# === Prod (injectées via AWS Secrets Manager) ===
# AWS_REGION=eu-west-1
# AWS_PROFILE=gravia-prod
